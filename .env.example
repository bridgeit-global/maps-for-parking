NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_TILESET_ID=
NEXT_PUBLIC_TILESET_URL=

# Supabase — maps-for-parking project. Publishable key is safe in the browser.
# Magic-link redirects must be allowlisted in Supabase Auth:
#   http://localhost:3000/auth/callback
#   https://<production-host>/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used to read contributor email addresses and sign unsubscribe links.
SUPABASE_SECRET_KEY=

# Occasional view-milestone mail. Password stays in this file locally and is never committed.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support@parkourai.com
SMTP_PASSWORD=
